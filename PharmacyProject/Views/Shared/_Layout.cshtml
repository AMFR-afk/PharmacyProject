@using PharmacyProject.Helpers
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nova Pharmacy</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* === حل مشكلة تغطية المحتوى === */
        body {
            padding-top: 90px; /* دفشنا الصفحة لتحت عشان الناف بار ما يغطي اشي */
            background-color: #fcfcfc; /* لون خلفية هادي للصفحة كلها */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* === تصميم الناف بار الجديد (واضح ونظيف) === */
        .premium-navbar {
            background-color: #ffffff; /* أبيض صريح للوضوح */
            box-shadow: 0 4px 25px rgba(0,0,0,0.05); /* ظل ناعم جداً للفخامة */
            padding: 15px 0; /* مساحة مريحة */
            transition: all 0.3s ease;
        }

        /* اللوجو */
        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #333;
            display: flex;
            align-items: center;
        }

        .brand-icon {
            color: #764ba2;
            font-size: 1.8rem;
            margin-right: 8px;
        }

        /* الروابط */
        .nav-link {
            color: #555 !important;
            font-weight: 600;
            font-size: 1rem;
            margin: 0 12px;
            padding: 8px 16px !important;
            border-radius: 50px;
            transition: all 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                color: #764ba2 !important;
                background-color: #f3eafa; /* خلفية بنفسجية فاتحة جداً عند اللمس */
            }

        /* زر الخروج */
        .btn-logout {
            border: 1px solid #ffe3e3;
            background-color: #fff5f5;
            color: #dc3545;
            font-weight: 600;
            padding: 8px 20px;
            border-radius: 50px;
            transition: all 0.3s;
        }

            .btn-logout:hover {
                background-color: #dc3545;
                color: white;
                border-color: #dc3545;
            }

        /* منطقة المستخدم */
        .user-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8f9fa;
            padding: 5px 5px 5px 15px;
            border-radius: 50px;
            border: 1px solid #eee;
        }

        .user-name {
            color: #333;
            font-weight: 700;
            font-size: 0.9rem;
        }

        /* أيقونة السلة */
        .cart-icon-wrapper {
            position: relative;
            color: #333;
            margin-right: 15px;
            transition: transform 0.2s;
        }

            .cart-icon-wrapper:hover {
                color: #764ba2;
                transform: scale(1.1);
            }

        .cart-badge {
            position: absolute;
            top: -5px;
            right: -8px;
            background: linear-gradient(45deg, #ff3547, #ff6b6b);
            color: white;
            font-size: 0.7rem;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 2px solid white;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top premium-navbar">
        <div class="container">

            <a class="navbar-brand" asp-controller="Pharmacy" asp-action="Table">
                <i class="bi bi-capsule-pill brand-icon"></i>
                <span style="background: linear-gradient(45deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Nova</span> Pharmacy
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Pharmacy" asp-action="Table">
                            <i class="bi bi-shop me-1"></i> Store
                        </a>
                    </li>

                    @if (Context.Session.GetString("Role") == "ADMIN")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pharmacy" asp-action="AdminTable">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center">

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <a asp-controller="Pharmacy" asp-action="Cart" class="cart-icon-wrapper text-decoration-none">
                            <i class="bi bi-cart3 fs-4"></i>
                            @{
                                var cart = Context.Session.GetObject<List<PharmacyProject.Models.CartItem>>("CART");
                                var count = cart != null ? cart.Count : 0;
                            }
                            @if (count > 0)
                            {
                                <span class="cart-badge">@count</span>
                            }
                        </a>

                        <div class="user-pill ms-2">
                            <span class="user-name">
                                <i class="bi bi-person-circle text-primary me-1"></i>
                                @Context.Session.GetString("UserName")
                            </span>

                            <form asp-controller="Pharmacy" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-logout rounded-pill btn-sm">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Pharmacy" asp-action="Login" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm"
                           style="background: linear-gradient(45deg, #667eea, #764ba2); border: none;">
                            Login
                        </a>
                    }
                </div>

            </div>
        </div>
    </nav>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 py-3 bg-white">
        <div class="container text-center">
            &copy; 2026 - Nova Pharmacy System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>