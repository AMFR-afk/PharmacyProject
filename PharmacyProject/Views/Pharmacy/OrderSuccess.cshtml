@{
    ViewData["Title"] = "Order Success";
}

<div class="container text-center mt-5" style="min-height: 60vh;">
    <div class="card shadow-sm border-0 p-5">
        <div class="mb-4">
            <h1 class="text-success display-1">
                <i class="bi bi-check-circle-fill"></i> &#10004;
            </h1>
        </div>

        <h2 class="fw-bold text-success">Order Placed Successfully!</h2>
        <p class="lead text-muted mt-3">Thank you for shopping with us. Your medicines are ready.
           You can come to the pharmacy to take your order
        </p>

        <div class="mt-4">
            <a asp-action="Table" class="btn btn-primary btn-lg px-5">Back to Home</a>
        </div>
    </div>
</div>