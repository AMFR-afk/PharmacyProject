@model PharmacyProject.Models.Prop

@{
    ViewData["Title"] = "Edit Medicine";
}

<style>
    /* نفس الستايل السابق لتوحيد الشكل */
    .form-card {
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        background: white;
    }

    .glass-header-small {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 3rem 2rem;
        text-align: center;
        color: white;
    }

    .file-upload-wrapper {
        position: relative;
        height: 150px;
        border: 2px dashed #e0e0e0;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fcfcfc;
        transition: all 0.3s;
    }

        .file-upload-wrapper:hover {
            border-color: #764ba2;
            background: #f3eafa;
        }

    .file-upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .form-control {
        border-radius: 0.75rem;
        padding: 1rem;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1);
        }

    .btn-update {
        background: linear-gradient(45deg, #11998e, #38ef7d); /* لون أخضر للتحديث */
        border: none;
        color: white;
        padding: 1rem;
        font-weight: 700;
        border-radius: 0.75rem;
        transition: transform 0.2s;
    }

        .btn-update:hover {
            transform: scale(1.02);
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card form-card">

                <div class="glass-header-small">
                    <h2 class="fw-bold mb-2">Edit Medicine</h2>
                    <p class="opacity-75 mb-0">Update details for @Model.Name</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <div class="form-floating mb-3">
                                    <input asp-for="Name" class="form-control" placeholder="Medicine Name" />
                                    <label asp-for="Name">Medicine Name</label>
                                    <span asp-validation-for="Name" class="text-danger small ps-2"></span>
                                </div>

                                <div class="form-floating">
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Price" />
                                    <label asp-for="Price">Price (JOD)</label>
                                    <span asp-validation-for="Price" class="text-danger small ps-2"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="file-upload-wrapper text-center">
                                    <input type="file" name="imageFile" class="file-upload-input" accept=".png,.jpg,.jpeg,.webp" onchange="previewImage(this)" />

                                    <div class="text-muted" id="uploadText" style="@(Context.Request.PathBase)/images/medicines/@(Model.Id).png ? 'display:none' : ''">
                                        <i class="bi bi-arrow-repeat fs-1 text-success"></i>
                                        <div class="small mt-2">Change Image</div>
                                    </div>

                                    <img id="imgPreview" src="/images/medicines/@(Model.Id).png"
                                         onerror="this.style.display='none'; document.getElementById('uploadText').style.display='block'; document.querySelector('.bi-arrow-repeat').classList.replace('bi-arrow-repeat', 'bi-cloud-arrow-up'); document.querySelector('.text-success').classList.replace('text-success', 'text-secondary');"
                                         style="max-height: 100%; max-width: 100%; border-radius: 0.8rem;" />
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Details" class="form-control" placeholder="Description" style="height: 120px"></textarea>
                            <label asp-for="Details">Description & Details</label>
                            <span asp-validation-for="Details" class="text-danger small ps-2"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-update shadow-sm">
                                <i class="bi bi-check-circle-fill me-2"></i> Update Changes
                            </button>
                            <a asp-action="AdminTable" class="btn btn-light py-3 rounded-3 text-secondary fw-bold border">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById('imgPreview');
        var text = document.getElementById('uploadText');

        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                if(text) text.style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}