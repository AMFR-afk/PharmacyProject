@using PharmacyProject.Helpers
@using Microsoft.AspNetCore.Hosting
@using System.IO
@inject IWebHostEnvironment Env

@model IEnumerable<PharmacyProject.Models.Prop>

@{
    ViewData["Title"] = "Pharmacy Store";
}

<style>
    /* هيدر زجاجي فخم */
    .glass-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 4rem 2rem;
        border-radius: 1.5rem;
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.25);
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }

    /* كرت المنتج */
    .medicine-card {
        border: none;
        border-radius: 1.25rem;
        background: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

        .medicine-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }

    /* حاوية الصورة/الأيقونة */
    .img-container {
        height: 220px;
        width: 100%;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    /* تنسيق الصورة */
    .med-img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* عشان تغطي المساحة كاملة بدون ما تمط */
        transition: transform 0.5s ease;
    }

    .medicine-card:hover .med-img {
        transform: scale(1.1); /* زووم خفيف عند التحويم */
    }

    /* تنسيق الأيقونة (في حال عدم وجود صورة) */
    .icon-placeholder {
        color: #764ba2;
        transition: all 0.5s ease;
    }

    .medicine-card:hover .icon-placeholder {
        transform: scale(1.1) rotate(10deg);
    }

    /* السعر */
    .price-tag {
        color: #764ba2;
        font-weight: 900;
        font-size: 1.4rem;
    }

    /* زر الإضافة */
    .btn-add {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: none;
        color: white;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

        .btn-add:hover {
            background: linear-gradient(45deg, #764ba2, #667eea);
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.3);
        }

    /* زر التفاصيل */
    .btn-details {
        border: 2px solid #e9ecef;
        color: #6c757d;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-details:hover {
            border-color: #6c757d;
            background: #6c757d;
            color: white;
        }
</style>

<div class="container py-4">

    <div class="glass-header text-center">
        <div style="position: absolute; top: -50px; left: -50px; width: 150px; height: 150px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
        <div style="position: absolute; bottom: -30px; right: -30px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>

        <h1 class="display-4 fw-bold mb-3 position-relative">Pharmacy Care+</h1>
        <p class="lead opacity-90 position-relative">Your trusted destination for health & wellness.</p>

        <div class="row justify-content-center mt-4 position-relative">
            <div class="col-md-6">
                <form asp-action="Table" method="get">
                    <div class="input-group p-1 bg-white rounded-pill shadow-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                               class="form-control border-0 shadow-none ps-4 rounded-pill"
                               placeholder="Search for medicine name...">

                        <button class="btn btn-primary rounded-pill px-4 fw-bold m-1" type="submit" style="background: #764ba2; border: none;">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>

                    @if (ViewData["CurrentFilter"] != null)
                    {
                        <div class="text-center mt-2">
                            <a asp-action="Table" class="text-white text-decoration-none small opacity-75 hover-opacity-100">
                                <i class="bi bi-x-circle-fill"></i> Clear Results
                            </a>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3 opacity-25"><i class="bi bi-box-seam" style="font-size: 4rem;"></i></div>
            <h4 class="text-muted fw-bold">No medicines found.</h4>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                // ==========================================
                // 1. لوجيك البحث عن الصورة (بدون أخطاء)
                // ==========================================
                string? imagePath = null;
                var extensions = new[] { ".png", ".jpg", ".jpeg", ".webp" };

                // التأكد من أن الـ Env ليس null
                var webRoot = Env.WebRootPath ?? "";

                foreach (var ext in extensions)
                {
                    // استخدام System.IO.Path بشكل صريح لمنع الخطأ
                    var filePath = System.IO.Path.Combine(webRoot, "images", "medicines", item.Id + ext);

                    if (System.IO.File.Exists(filePath))
                    {
                        imagePath = $"/images/medicines/{item.Id}{ext}";
                        break;
                    }
                }
                // ==========================================

                <div class="col">
                    <div class="card h-100 medicine-card">

                        <div class="img-container">
                            @if (imagePath != null)
                            {
                                <img src="@imagePath" class="med-img" alt="@item.Name">
                            }
                            else
                            {
                                <div class="icon-placeholder">
                                    <i class="bi bi-capsule-pill" style="font-size: 4.5rem;"></i>
                                </div>
                            }

                            <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-light text-dark shadow-sm border">
                                ID: @item.Id
                            </span>
                        </div>

                        <div class="card-body text-center p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@item.Name</h5>

                            <p class="card-text text-muted small mb-3">
                                @(item.Details.Length > 45 ? item.Details.Substring(0, 45) + "..." : item.Details)
                            </p>

                            <div class="price-tag mb-4">@item.Price.ToString("0.00") JOD</div>

                            <div class="d-flex gap-2">
                                <form asp-action="AddToCart" method="post" class="d-flex gap-2 flex-grow-1">
                                    <input type="hidden" name="id" value="@item.Id" />

                                    <div class="form-floating" style="width: 35%;">
                                        <input type="number" name="quantity" value="1" min="1" max="10"
                                               class="form-control form-control-sm border-2 text-center fw-bold"
                                               id="qty-@item.Id" placeholder="Qty">
                                        <label for="qty-@item.Id" class="small fw-bold" style="font-size: 0.7rem;">Qty</label>
                                    </div>

                                    <button type="submit" class="btn btn-add flex-grow-1 fw-bold py-2">
                                        <i class="bi bi-bag-plus-fill me-1"></i> Add
                                    </button>
                                </form>

                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details d-flex align-items-center justify-content-center px-3">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>