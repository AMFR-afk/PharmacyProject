@model List<PharmacyProject.Models.Prop>

@{
    ViewData["Title"] = "Medicine List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-capsule"></i> Available Medicines</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Price</th>
                        <th>Details</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td class="text-success fw-bold">@item.Price.ToString("C")</td>
                            <td class="text-muted small">@item.Details</td>
                            
                            <form asp-action="AddToCart" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                
                                <td class="text-center">
                                    <div class="input-group input-group-sm d-inline-flex w-auto">
                                        <button type="button" class="btn btn-outline-secondary" onclick="updateQty(@item.Id, -1)">-</button>
                                        <input type="number" id="qty-Input-@item.Id" name="quantity" value="1" class="form-control text-center" style="width: 50px;" min="1" readonly>
                                        <button type="button" class="btn btn-outline-secondary" onclick="updateQty(@item.Id, 1)">+</button>
                                    </div>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Info</a>
                                        <button type="submit" class="btn btn-primary btn-sm">Add to Cart</button>
                                    </div>
                                </td>
                            </form>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function updateQty(id, change) {
        let input = document.getElementById("qty-Input-" + id);
        let currentVal = parseInt(input.value);
        let newVal = currentVal + change;
        
        if (newVal >= 1) {
            input.value = newVal;
        }
    }
</script>