@model PharmacyProject.Models.Prop

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-info text-white text-center">
            <h3>Medicine Details</h3>
        </div>
        <div class="card-body text-center py-5">
            <h2 class="card-title display-6">@Model.Name</h2>
            <h4 class="text-success my-3">@Model.Price.ToString("C")</h4>
            <p class="card-text text-muted">@Model.Details</p>
            <p class="small text-secondary">Product ID: #@Model.Id</p>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between p-3">
            <a asp-action="Table" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>