@model PharmacyProject.Models.Prop

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0">

            <div class="col-md-5 d-flex align-items-center justify-content-center p-5 position-relative" style="background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);">
                <i class="bi bi-capsule-pill display-1 text-white" style="font-size: 8rem; filter: drop-shadow(0 10px 10px rgba(0,0,0,0.1));"></i>
            </div>

            <div class="col-md-7 bg-white">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 rounded-pill">Pharmacy Product</span>
                            <h2 class="fw-bold text-dark mb-0">@Model.Name</h2>
                        </div>
                        <h2 class="text-primary fw-bold">@Model.Price.ToString("0.00") JOD</h2>
                    </div>

                    <p class="lead text-muted mb-5" style="line-height: 1.8;">
                        @Model.Details
                    </p>

                    <form asp-action="AddToCart" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="row g-3 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label fw-bold text-secondary small">Quantity</label>
                                <input type="number" name="quantity" class="form-control text-center rounded-3 border-2" value="1" min="1" max="10">
                            </div>

                            <div class="col-sm-8">
                                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm" style="background: linear-gradient(45deg, #667eea, #764ba2); border: none;">
                                    <i class="bi bi-cart-plus-fill me-2"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="mt-5 pt-3 border-top">
                        <a asp-action="Table" class="text-decoration-none text-muted fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Back to Store
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>