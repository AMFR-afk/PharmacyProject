@using PharmacyProject.Helpers
@using PharmacyProject.Models
@using System.Linq

@{
    ViewData["Title"] = "Your Cart";
    var cart = Context.Session.GetObject<List<CartItem>>("CART") ?? new List<CartItem>();
    var total = cart.Sum(x => x.LineTotal);
}

<div class="container mt-5">
    <h2 class="mb-4">Shopping Cart <span class="badge bg-secondary rounded-pill">@cart.Count</span></h2>

    @if (!cart.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Your cart is empty!</h4>
            <p>Looks like you haven't added any medicine yet.</p>
            <a asp-action="Table" class="btn btn-primary mt-2">Go to Store</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <table class="table table-borderless align-middle mb-0">
                        <thead class="border-bottom bg-light">
                            <tr>
                                <th class="ps-4">Medicine</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cart)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4 fw-bold">@item.Name</td>
                                    <td>@item.Price.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2">@item.Quantity</span>
                                    </td>
                                    <td class="fw-bold">@item.LineTotal.ToString("C")</td>
                                    <td>
                                        <form asp-action="RemoveFromCart" method="post">
                                            <input type="hidden" name="medicineId" value="@item.MedicineId" />
                                            <button class="btn btn-outline-danger btn-sm rounded-circle">×</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form asp-action="ClearCart" method="post" class="mt-3">
                    <button class="btn btn-outline-danger btn-sm">Empty Cart</button>
                </form>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm bg-light border-0">
                    <div class="card-body">
                        <h5 class="card-title">Order Summary</h5>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <span class="fw-bold">@total.ToString("C")</span>
                        </div>
                        <div class="d-grid">
                            <a asp-action="Checkout" class="btn btn-success btn-lg">Checkout</a>
                            <a asp-action="Table" class="btn btn-link text-decoration-none mt-2">Continue Shopping</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>