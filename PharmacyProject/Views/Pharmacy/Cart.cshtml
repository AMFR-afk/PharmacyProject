@using PharmacyProject.Helpers
@using PharmacyProject.Models
@using System.Linq

@{
    ViewData["Title"] = "Your Cart";
    var cart = Context.Session.GetObject<List<CartItem>>("CART") ?? new List<CartItem>();
    var total = cart.Sum(x => x.LineTotal);
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">Shopping Cart <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fs-5 align-middle ms-2">@cart.Count Items</span></h2>

    @if (!cart.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <div class="mb-3 text-muted opacity-25">
                <i class="bi bi-cart-x" style="font-size: 5rem;"></i>
            </div>
            <h4 class="fw-bold text-muted">Your cart is empty!</h4>
            <p class="text-secondary mb-4">Looks like you haven't added any medicine yet.</p>
            <a asp-action="Table" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Product</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold">Price</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold">Quantity</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold">Total</th>
                                    <th class="pe-4 py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cart)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 p-2 rounded me-3 text-primary">
                                                    <i class="bi bi-capsule"></i>
                                                </div>
                                                @item.Name
                                            </div>
                                        </td>
                                        <td class="text-muted">@item.Price.ToString("0.00")</td>
                                        <td>
                                            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill">@item.Quantity</span>
                                        </td>
                                        <td class="fw-bold text-primary">@item.LineTotal.ToString("0.00")</td>
                                        <td class="pe-4 text-end">
                                            <form asp-action="RemoveFromCart" method="post">
                                                <input type="hidden" name="medicineId" value="@item.MedicineId" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center"
                                                        style="width: 32px; height: 32px; padding: 0;"
                                                        title="Remove Item">
                                                    <i class="bi bi-x-lg">X</i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <form asp-action="ClearCart" method="post" class="mt-3 text-end">
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-trash3 me-1"></i> Empty Cart
                    </button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow rounded-4 text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Order Summary</h4>
                        <hr class="border-white opacity-50">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span class="fw-bold">@total.ToString("0.00") JOD</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 opacity-75">
                            <span>Tax (0%)</span>
                            <span>0.00 JOD</span>
                        </div>

                        <div class="d-flex justify-content-between mb-4 fs-4 fw-bold border-top border-white border-opacity-25 pt-3">
                            <span>Total</span>
                            <span>@total.ToString("0.00") JOD</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-light text-success fw-bold py-3 rounded-3 shadow-sm">
                                Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                            <a asp-action="Table" class="btn btn-outline-light btn-sm rounded-3 mt-2 border-0">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>