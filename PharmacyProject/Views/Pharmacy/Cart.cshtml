@using PharmacyProject.Helpers
@using PharmacyProject.Models
@using System.Linq

@{
    ViewData["Title"] = "Your Cart";
    var cart = Context.Session.GetObject<List<CartItem>>("CART") ?? new List<CartItem>();
    var total = cart.Sum(x => x.LineTotal);
}

<style>
    /* تنسيق مربع الأيقونة (بديل الصورة) */
    .cart-item-icon {
        width: 60px;
        height: 60px;
        background-color: #f8f9fa;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #764ba2;
        font-size: 1.5rem;
        transition: all 0.3s ease;
    }

    tr:hover .cart-item-icon {
        background-color: #e0c3fc;
        transform: scale(1.1);
    }

    /* كرت الملخص الملون */
    .summary-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

    /* زر الحذف */
    .btn-remove {
        width: 35px;
        height: 35px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.2s;
    }

        .btn-remove:hover {
            background-color: #dc3545;
            color: white;
            border-color: #dc3545;
        }
</style>

<div class="container py-5">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-cart3 me-2" style="color: #764ba2;"></i> Shopping Cart
        </h2>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-6 shadow-sm">
            @cart.Count Items
        </span>
    </div>

    @if (!cart.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="mb-3 opacity-25">
                <i class="bi bi-cart-x" style="font-size: 6rem; color: #764ba2;"></i>
            </div>
            <h3 class="fw-bold text-dark">Your cart is empty!</h3>
            <p class="text-muted mb-4">Looks like you haven't added any medicine yet.</p>
            <a asp-action="Table" class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm"
               style="background: linear-gradient(45deg, #667eea, #764ba2); border: none;">
                <i class="bi bi-arrow-left me-2"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Product</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold text-center">Price</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold text-center">Qty</th>
                                    <th class="py-3 text-secondary text-uppercase small fw-bold text-end">Total</th>
                                    <th class="pe-4 py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cart)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="cart-item-icon me-3 shadow-sm">
                                                    <i class="bi bi-capsule-pill"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">@item.Name</h6>
                                                    <small class="text-muted">ID: @item.MedicineId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted text-center">@item.Price.ToString("0.00")</td>
                                        <td class="text-center">
                                            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                                                @item.Quantity
                                            </span>
                                        </td>
                                        <td class="fw-bold text-primary text-end" style="color: #764ba2 !important;">
                                            @item.LineTotal.ToString("0.00")
                                        </td>
                                        <td class="pe-4 text-end">
                                            <form asp-action="RemoveFromCart" method="post">
                                                <input type="hidden" name="medicineId" value="@item.MedicineId" />
                                                <button type="submit" class="btn btn-outline-danger btn-remove shadow-sm" title="Remove Item">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <form asp-action="ClearCart" method="post" class="mt-3 text-end">
                    <button class="btn btn-link text-danger text-decoration-none opacity-75 hover-opacity-100">
                        <i class="bi bi-trash3 me-1"></i> Empty Entire Cart
                    </button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="card summary-card shadow-lg rounded-4">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Order Summary</h4>
                        <hr class="border-white opacity-50">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span class="fw-bold">@total.ToString("0.00") JOD</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 opacity-75">
                            <span>Tax (0%)</span>
                            <span>0.00 JOD</span>
                        </div>

                        <div class="d-flex justify-content-between mb-4 fs-4 fw-bold border-top border-white border-opacity-25 pt-3">
                            <span>Total</span>
                            <span>@total.ToString("0.00") JOD</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-light text-primary fw-bold py-3 rounded-3 shadow-sm" style="color: #764ba2 !important;">
                                Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
                            </a>

                            <div class="text-center small mt-2 opacity-75">
                                <i class="bi bi-cash-coin me-1"></i> Cash on Delivery only
                            </div>

                            <a asp-action="Table" class="btn btn-outline-light btn-sm rounded-3 mt-3 border-0 opacity-75 hover-opacity-100">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>