@model PharmacyProject.Models.Prop

@{
    ViewData["Title"] = "Add Medicine";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header border-0 text-center py-4" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <h3 class="fw-bold text-white mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Medicine</h3>
                    <p class="text-white-50 small mb-0">Expand your pharmacy inventory</p>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-action="Add" method="post">

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control rounded-3" placeholder="Medicine Name" />
                            <label asp-for="Name">Medicine Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Details" class="form-control rounded-3" placeholder="Description" style="height: 120px"></textarea>
                            <label asp-for="Details">Description</label>
                            <span asp-validation-for="Details" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Price" class="form-control rounded-3" type="number" step="0.01" placeholder="Price" />
                            <label asp-for="Price">Price (JOD)</label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3 shadow-sm" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0); border: none;">
                                Save Medicine
                            </button>
                            <a asp-action="AdminTable" class="btn btn-outline-secondary rounded-3">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}