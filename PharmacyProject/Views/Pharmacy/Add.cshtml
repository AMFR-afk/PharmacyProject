@model PharmacyProject.Models.Prop

@{
    ViewData["Title"] = "Add Medicine";
}

<style>
    /* تصميم الكرت */
    .form-card {
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        background: white;
    }

    /* الهيدر البنفسجي */
    .glass-header-small {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 3rem 2rem;
        text-align: center;
        color: white;
        position: relative;
    }

    /* تنسيق حقل الملفات */
    .file-upload-wrapper {
        position: relative;
        height: 150px;
        border: 2px dashed #e0e0e0;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fcfcfc;
        transition: all 0.3s;
    }

        .file-upload-wrapper:hover {
            border-color: #764ba2;
            background: #f3eafa;
        }

    .file-upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    /* الأزرار والحقول */
    .form-control {
        border-radius: 0.75rem;
        padding: 1rem;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1);
        }

    .btn-save {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: none;
        color: white;
        padding: 1rem;
        font-weight: 700;
        border-radius: 0.75rem;
        transition: transform 0.2s;
    }

        .btn-save:hover {
            transform: scale(1.02);
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card form-card">

                <div class="glass-header-small">
                    <h2 class="fw-bold mb-2">Add New Medicine</h2>
                    <p class="opacity-75 mb-0">Enter medicine details below</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Add" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <div class="form-floating mb-3">
                                    <input asp-for="Name" class="form-control" placeholder="Medicine Name" />
                                    <label asp-for="Name">Medicine Name</label>
                                    <span asp-validation-for="Name" class="text-danger small ps-2"></span>
                                </div>

                                <div class="form-floating">
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Price" />
                                    <label asp-for="Price">Price (JOD)</label>
                                    <span asp-validation-for="Price" class="text-danger small ps-2"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="file-upload-wrapper text-center">
                                    <input type="file" name="imageFile" class="file-upload-input" accept=".png,.jpg,.jpeg,.webp" onchange="previewImage(this)" />
                                    <div class="text-muted" id="uploadText">
                                        <i class="bi bi-cloud-arrow-up fs-1 text-primary" style="color: #764ba2 !important;"></i>
                                        <div class="small mt-2">Upload Image</div>
                                    </div>
                                    <img id="imgPreview" src="#" alt="Preview" style="display:none; max-height: 100%; max-width: 100%; border-radius: 0.8rem;" />
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Details" class="form-control" placeholder="Description" style="height: 120px"></textarea>
                            <label asp-for="Details">Description & Details</label>
                            <span asp-validation-for="Details" class="text-danger small ps-2"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-save shadow-sm">
                                <i class="bi bi-check-circle-fill me-2"></i> Save Medicine
                            </button>
                            <a asp-action="AdminTable" class="btn btn-light py-3 rounded-3 text-secondary fw-bold border">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // كود جافاسكريبت بسيط لعرض الصورة قبل الرفع
    function previewImage(input) {
        var preview = document.getElementById('imgPreview');
        var text = document.getElementById('uploadText');

        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                text.style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}