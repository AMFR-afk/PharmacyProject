@model PharmacyProject.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    /* خلفية الصفحة بالكامل */
    .login-bg {
        background: linear-gradient(135deg, #fdfbfd 0%, #f3eafa 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* كرت تسجيل الدخول */
    .login-card {
        border: none;
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        box-shadow: 0 20px 40px rgba(118, 75, 162, 0.15);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

        .login-card:hover {
            transform: translateY(-5px);
        }

    /* الأيقونة العلوية */
    .icon-circle {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        color: white;
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
    }

    /* تنسيق الحقول */
    .form-control {
        border-radius: 0.75rem;
        border: 2px solid #f1f3f5;
        padding: 1rem 0.75rem;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1);
        }

    /* الليبل العائم */
    .form-floating > label {
        padding-left: 1rem;
        color: #6c757d;
    }

    /* زر الدخول */
    .btn-login {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: none;
        color: white;
        border-radius: 0.75rem;
        padding: 1rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            background: linear-gradient(45deg, #764ba2, #667eea);
            transform: scale(1.02);
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
            color: white;
        }

    /* رابط إنشاء حساب */
    .link-create {
        color: #764ba2;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s;
    }

        .link-create:hover {
            color: #5e3a8a;
            text-decoration: underline;
        }
</style>

<div class="container-fluid login-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">

                <div class="card login-card p-4">
                    <div class="card-body">

                        <div class="text-center mb-5">
                            <div class="icon-circle">
                                <i class="bi bi-person-lock fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                            <p class="text-muted small">Please sign in to access your account</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger text-center small fw-bold border-0 rounded-3 mb-4" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                                <label asp-for="Email">Email Address</label>
                                <span asp-validation-for="Email" class="text-danger small ps-2"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Password" class="form-control" placeholder="Password" type="password" />
                                <label asp-for="Password">Password</label>
                                <span asp-validation-for="Password" class="text-danger small ps-2"></span>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-login">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                                </button>
                            </div>

                            <div class="text-center border-top pt-4">
                                <p class="text-muted mb-1 small">Don't have an account?</p>
                                <a asp-action="SignUp" class="link-create">Create New Account</a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4 text-muted small opacity-75">
                    &copy; 2026 Nova Pharmacy System
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}