@model PharmacyProject.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid bg-light" style="min-height: 100vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <div class="bg-primary bg-opacity-10 text-primary d-inline-block p-3 rounded-circle mb-3">
                                <i class="bi bi-person-lock fs-1"></i>
                            </div>
                            <h3 class="fw-bold text-dark">Welcome Back</h3>
                            <p class="text-muted small">Please sign in to continue</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center fw-bold"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" />
                                <label asp-for="Email">Email Address</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Password" class="form-control rounded-3" placeholder="Password" type="password" />
                                <label asp-for="Password">Password</label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0); border: none;">
                                    Sign In
                                </button>
                            </div>

                            <div class="text-center">
                                <p class="text-muted mb-0 small">Don't have an account?</p>
                                <a asp-action="SignUp" class="text-decoration-none fw-bold text-primary">Create New Account</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}